# Copied to .env by bin/setup_secrets.sh, which also fills in the keys.
# .env is ignored by git. Never commit it.

# One API key per person. NGINX turns the key into a user name.
ALICE_API_KEY=
BOB_API_KEY=
# Shared only between NGINX and the API, so nothing can skip the gateway
INTERNAL_API_KEY=

# The model that decides which tools to call (chosen for reliable tool calling)
AGENT_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Most model calls the agent may make for one request
AGENT_MAX_STEPS=6
# 0 = the same request gets the same behavior (repeatable experiments)
OLLAMA_TEMPERATURE=0

# Extra tools from outside "tool servers" (comma-separated). The team installed
# a shipment tracker from a freight partner. Part 2 shows what that can mean.
PLUGIN_URLS=http://partner-news.example/tools.json
